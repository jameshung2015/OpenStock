# Database Configuration
MONGODB_URI=mongodb://root:example@mongodb:27017/openstock?authSource=admin

# Authentication
BETTER_AUTH_SECRET=your_better_auth_secret_here_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Email Configuration (Gmail)
NODEMAILER_EMAIL=youraddress@gmail.com
NODEMAILER_PASSWORD=your_gmail_app_password

# Market Data APIs
FINNHUB_API_KEY=your_finnhub_api_key

# Tushare API (Optional - for Chinese market data)
TUSHARE_TOKEN=your_tushare_token

# Ollama AI Configuration
# URL to access Ollama from Docker container (Windows host)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model to use (must be downloaded on your Windows machine)
# Recommended models: llama3.2, llama3.1, mistral, qwen2.5
# Download with: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Ollama request timeout in milliseconds (default: 120000 = 2 minutes)
OLLAMA_TIMEOUT=120000

# Legacy: Gemini API (deprecated, replaced by Ollama)
# GEMINI_API_KEY=your_gemini_api_key
